# Copy to backend/.env (git-ignored) and fill in
POSTGRES_DB=movie_rating_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Optional: full SQLAlchemy URL overrides the POSTGRES_* values for the Flask app
# DATABASE_URL=postgresql://user:pass@localhost:5432/movie_rating_system
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me
